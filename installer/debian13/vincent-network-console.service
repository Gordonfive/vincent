[Unit]
Description=Vincent network recovery console
After=NetworkManager.service network.target
Wants=NetworkManager.service
Conflicts=getty@tty3.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/vincent-network-console
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty3
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
