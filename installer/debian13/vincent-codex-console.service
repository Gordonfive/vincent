[Unit]
Description=Vincent interactive Codex console
After=local-fs.target
Conflicts=getty@tty2.service

[Service]
Type=simple
ExecStart=/usr/local/sbin/vincent-codex-console
Restart=always
RestartSec=2
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/tty2
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes

[Install]
WantedBy=multi-user.target
